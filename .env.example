# Environment configuration for RasoiAI

# Supabase database configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_service_role_key_here

# Groq API configuration for LLM fallback recipe generation
GROQ_API_KEY=your_groq_api_key_here

# Backend CORS origins configuration (comma-separated for multiple origins)
ALLOWED_ORIGINS=https://rasoiai.vercel.app,http://localhost:5173,http://localhost:3000
